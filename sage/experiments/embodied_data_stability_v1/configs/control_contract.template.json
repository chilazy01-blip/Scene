    "action.fields_order_units_bounds",
    "action.duration_and_hold_semantics",
    "control.physics_low_high_frequencies",
    "control.native_transition_semantics",
    "frames.world_base_task_camera",
    "task.stage_and_transition_predicates",
    "hooks.policy_rgbd_proprio_action",
